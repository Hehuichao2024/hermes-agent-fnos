#!/command/with-contenv sh
# shellcheck shell=sh
# Dashboard service (dual-stack patched). Same guard logic as original,
# but uses the dual-stack Python wrapper instead of 'hermes dashboard'
# so uvicorn binds :: with IPV6_V6ONLY=0 (dual-stack mode).

case "${HERMES_DASHBOARD:-}" in
    1|true|TRUE|True|yes|YES|Yes) ;;
    *)
        exit 0
        ;;
esac

export HOME=/opt/data

cd /opt/data
# shellcheck disable=SC1091
. /opt/hermes/.venv/bin/activate

# Skip the drop when already non-root.
if [ "$(id -u)" = 0 ]; then
    exec s6-setuidgid hermes /opt/hermes/dual_stack_dashboard.py
else
    exec /opt/hermes/dual_stack_dashboard.py
fi
